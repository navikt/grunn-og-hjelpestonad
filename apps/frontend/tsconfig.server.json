{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2025",
    "lib": ["DOM", "DOM.Iterable", "ES2025"],
    "moduleResolution": "Bundler",
    "rootDir": "app/server",
    "outDir": "dist",
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["app/server/**/*.ts"],
  "exclude": ["node_modules", "build", "dist"]
}
