{
  "name": "grunn-og-hjelpestonad-frontend",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "react-router build",
    "build:server": "vite build --config vite.server.config.ts",
    "dev": "tsx --env-file=.env ./app/server/server.ts",
    "dev:vite": "react-router dev",
    "generate:api": "openapi-ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "start": "node dist/server.js",
    "start:dev": "npm run build && npm run build:server && node dist/server.js",
    "test": "tsx --test \"app/**/*.test.ts\"",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@grafana/faro-web-sdk": "2.12.1",
    "@grafana/faro-web-tracing": "2.12.1",
    "@navikt/aksel-icons": "8.19.2",
    "@navikt/ds-css": "8.19.2",
    "@navikt/ds-react": "8.19.2",
    "@navikt/oasis": "4.2.2",
    "@opentelemetry/api": "1.10.0",
    "@react-pdf/renderer": "4.9.0",
    "@react-router/express": "8.5.0",
    "cookie-parser": "1.4.7",
    "date-fns": "^4.4.0",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "isbot": "5.2.2",
    "prom-client": "15.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@react-router/dev": "8.5.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-babel": "1.7.3"
  }
}
