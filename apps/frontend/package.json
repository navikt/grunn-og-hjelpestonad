{
  "name": "grunn-og-hjelpestonad-frontend",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:server": "tsc ./app/server/server.ts --outDir dist --target es2022 --module esnext --moduleResolution bundler --allowImportingTsExtensions false",
    "dev": "tsx --env-file=.env ./app/server/server.ts",
    "dev:vite": "react-router dev",
    "lint": "eslint . --max-warnings=0",
    "start": "node dist/server.js",
    "start:dev": "npm run build && react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@navikt/aksel-icons": "8.16.2",
    "@navikt/ds-css": "8.16.2",
    "@navikt/ds-react": "8.16.2",
    "@navikt/oasis": "4.2.0",
    "@react-pdf/renderer": "4.9.0",
    "@react-router/node": "7.15.0",
    "@react-router/serve": "7.15.0",
    "cookie-parser": "1.4.7",
    "date-fns": "^4.4.0",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "isbot": "5.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.15.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-typescript": "7.28.5",
    "@eslint/js": "9.39.2",
    "@react-router/dev": "7.15.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "25.7.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.6",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jiti": "2.7.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.1",
    "vite-plugin-babel": "1.7.3",
    "vite-tsconfig-paths": "6.1.1"
  }
}
