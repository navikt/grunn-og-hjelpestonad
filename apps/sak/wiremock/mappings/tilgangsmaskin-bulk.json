{
  "name": "Tilgangsmaskin - bulk OBO tilgangssjekk",
  "request": {
    "method": "POST",
    "url": "/api/v1/bulk/obo"
  },
  "response": {
    "status": 207,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"ansattId\":\"Z999999\",\"resultater\":[{{#each (parseJson request.body) as |b|}}{\"brukerId\":\"{{b.brukerId}}\",\"status\":204}{{#unless @last}},{{/unless}}{{/each}}]}",
    "transformers": ["response-template"]
  },
  "priority": 10
}
