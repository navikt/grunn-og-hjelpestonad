{
  "name": "grunn-og-hjelpestonad-frontend",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:server": "tsc ./app/server/server.ts --outDir dist --target es2022 --module esnext --moduleResolution bundler --allowImportingTsExtensions false",
    "dev": "tsx --env-file=.env ./app/server/server.ts",
    "dev:vite": "react-router dev",
    "lint": "eslint . --max-warnings=0",
    "start": "node dist/server.js",
    "start:dev": "npm run build && react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@navikt/aksel-icons": "8.13.1",
    "@navikt/ds-css": "8.13.1",
    "@navikt/ds-react": "8.13.1",
    "@navikt/oasis": "4.1.4",
    "@react-pdf/renderer": "4.5.1",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "cookie-parser": "1.4.7",
    "date-fns": "^4.4.0",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "isbot": "5.1.44",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.3.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "tsx": "4.22.4",
    "typescript": "7.0.2",
    "typescript-eslint": "8.62.0",
    "vite": "8.2.2",
    "vite-plugin-babel": "1.7.3",
    "vite-tsconfig-paths": "6.1.1"
  }
}
